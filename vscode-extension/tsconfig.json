{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "./out",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/client-shared.ts",
    "src/core-client.ts",
    "src/extension.ts",
    "src/logger.ts",
    "src/sidebar.ts"
  ],
  "exclude": ["node_modules", "out"]
}
