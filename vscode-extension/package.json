{
  "name": "devglobe",
  "displayName": "DevGlobe",
  "description": "Show your live coding presence on the DevGlobe world map",
  "version": "1.1.0",
  "publisher": "devglobe",
  "icon": "media/logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nako0/devglobe-extension"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "browser": "./out/web/extension-web.js",
  "scripts": {
    "build": "npm run compile",
    "compile": "npm run compile:node && npm run compile:web",
    "compile:node": "tsc -p ./ && node ./scripts/copy-core.mjs",
    "compile:web": "node ./scripts/build-web.mjs",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devglobe-sidebar",
          "title": "DevGlobe",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "devglobe-sidebar": [
        {
          "type": "webview",
          "id": "devglobe.sidebarView",
          "name": "DevGlobe"
        }
      ]
    },
    "commands": [
      {
        "command": "devglobe.setStatus",
        "title": "DevGlobe: Set Status Message"
      },
      {
        "command": "devglobe.toggleAnonymous",
        "title": "DevGlobe: Toggle Anonymous Mode"
      },
      {
        "command": "devglobe.toggleShareRepo",
        "title": "DevGlobe: Toggle Repo Sharing"
      },
      {
        "command": "devglobe.showCodingTime",
        "title": "DevGlobe: Show Coding Time"
      },
      {
        "command": "devglobe.openGlobe",
        "title": "DevGlobe: Open Globe"
      }
    ],
    "configuration": {
      "title": "DevGlobe",
      "properties": {
        "devglobe.statusMessage": {
          "type": "string",
          "default": "",
          "description": "Your current status message (max 100 chars)"
        },
        "devglobe.trackingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether DevGlobe heartbeat tracking is active"
        },
        "devglobe.shareRepo": {
          "type": "boolean",
          "default": false,
          "description": "Share your GitHub repository on your DevGlobe profile"
        },
        "devglobe.anonymousMode": {
          "type": "boolean",
          "default": false,
          "description": "Appear on a random city in your country instead of your real location"
        }
      }
    }
  }
}
